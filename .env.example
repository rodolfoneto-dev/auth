PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_ISSUER=auth-service
JWT_AUDIENCE=platform
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL_DAYS=15

# Credenciais de Seed / Bootstrap do Administrador
ADMIN_NAME="Master Admin UP!Experience"
ADMIN_EMAIL="admin@upexperience.com.br"
ADMIN_PASSWORD="your_secure_admin_password_here"
SEED_DEMO_PASSWORD="your_secure_demo_password_here"

# Opcional (E-mails transacionais em Produção / Pré-Prod)
APP_URL=http://localhost:4000
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=onboarding@meusistema.com

# Governança de Staging / Pré-Lançamento
# Defina BLOCK_REGISTRATION=1 para suspender novos cadastros públicos
BLOCK_REGISTRATION=0

